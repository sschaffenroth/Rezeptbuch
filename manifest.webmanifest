{
  "name": "Rezeptbuch",
  "short_name": "Rezepte",
  "description": "Rezepte, Wochenpläne und Einkaufslisten – synchronisiert mit Google Drive",
  "lang": "de",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#faf5ee",
  "theme_color": "#c4533a",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "rezepte", "accept": ["application/json", "text/json", "text/plain", "application/octet-stream", ".json"] }
      ]
    }
  },
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ]
}
